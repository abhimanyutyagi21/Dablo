PORT=4000
# Required in production: a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Only needed if the React app is served from a different origin than the API.
CLIENT_ORIGIN=http://localhost:5173
DATABASE_FILE=data/dablo.db
# Set to 1 when behind a reverse proxy (nginx, Caddy, Render, etc.) so click dedupe uses the real visitor IP.
TRUST_PROXY=

# ── Platform connections & AI (all optional; features turn on when their keys are set) ──
# Where the browser reaches the app. OAuth redirect URIs are built from this.
PUBLIC_URL=http://localhost:5173
# Encrypts stored platform tokens. Required in production (32+ random chars).
TOKEN_ENCRYPTION_KEY=
# YouTube (Google Cloud OAuth client). Redirect URI: <PUBLIC_URL>/api/integrations/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Twitch (dev.twitch.tv app). Redirect URI: <PUBLIC_URL>/api/integrations/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# AI summaries (console.anthropic.com). Model is optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Hours between automatic syncs of connected platforms and feeds (0 = off).
SYNC_INTERVAL_HOURS=6
